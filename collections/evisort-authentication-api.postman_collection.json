      "name": "Authentication",
      "description": {
        "content": "Exchange an Evisort API key for a short-lived JWT bearer token.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1e962ae2-a78a-497d-aede-654bc7eaa5a6",
          "name": "Generate a JWT token from an Evisort API key",
          "request": {
            "name": "Generate a JWT token from an Evisort API key",
            "description": {
              "content": "Exchanges an Evisort API key (created in the Evisort UI under the admin console / API management) for a short-lived JWT bearer token. The returned token is supplied as `Authorization: Bearer {token}` on all subsequent requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The Evisort API key issued from the Evisort UI.",
                "key": "EVISORT-API-KEY",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "6519a62e-0002-4331-b6d4-c8a7f43a8abf",
