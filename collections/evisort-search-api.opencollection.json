{
  "opencollection": "1.0.0",
  "info": {
    "name": "Evisort Authentication Search API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search documents in a workspace",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.evisort.com/v1/search",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeMapping",
                "value": "",
                "type": "query"
              },
              {
                "name": "returnUniqueFieldValues",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Searches contracts and documents in the workspace by type, category, field filters, clauses, and free-text terms. Results are paginated and can optionally include field-to-document mapping and unique field values."
        }
      ]
    }
  ],
  "bundled": true
}